# Local development only. Copy to .env and change the passwords
# (letters and digits only, since they are embedded in connection URLs).
POSTGRES_USER=sentry
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=pipelinesentry

RABBITMQ_USER=sentry
RABBITMQ_PASSWORD=change-me-rabbit

API_PORT=8000
RABBITMQ_UI_PORT=15672
# Host port of the local image registry. On macOS, AirPlay Receiver uses 5000: set e.g. 5001.
REGISTRY_PORT=5000

MAX_RETRIES=3
DEDUP_TTL_SECONDS=86400
CACHE_TTL_SECONDS=30

# Lets attack-lab send unsigned synthetic webhooks. Keep false outside local demos.
ALLOW_UNSIGNED_WEBHOOKS=true
GITHUB_WEBHOOK_SECRET=

# --- Member 2 (response, recovery, supply chain, policy). See INTEGRATION.md. ---
# dry_run = record the plan only | simulated = PipelineSentry-internal containment | live = real APIs
RESPONSE_MODE=dry_run
RESPONSE_MIN_SCORE=70
# Live mode stays off unless all three are set; only cancel_pipeline has a live integration.
RESPONSE_LIVE_ENABLED=false
RESPONSE_API_TOKEN=
GITHUB_TOKEN=
GITHUB_REPOSITORY=
# Encrypts the demo cosign key pair created in the cosignkeys volume
COSIGN_PASSWORD=change-me-cosign
