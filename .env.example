# Local development only. Copy to .env and change the passwords
# (letters and digits only, since they are embedded in connection URLs).
POSTGRES_USER=sentry
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=pipelinesentry

RABBITMQ_USER=sentry
RABBITMQ_PASSWORD=change-me-rabbit

API_PORT=8000
RABBITMQ_UI_PORT=15672

MAX_RETRIES=3
DEDUP_TTL_SECONDS=86400
CACHE_TTL_SECONDS=30

# Lets attack-lab send unsigned synthetic webhooks. Keep false outside local demos.
ALLOW_UNSIGNED_WEBHOOKS=true
GITHUB_WEBHOOK_SECRET=
